# --- server ---
PORT=4000
NODE_ENV=development
# comma-separated list of allowed frontend origins (storefront + admin)
ALLOWED_ORIGINS=http://localhost:3000

# --- database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fluffy
DB_CONNECTION_LIMIT=10
# DB_SSL=true
# DB_SSL_CA=/path/to/ca.pem
# DB_SSL_REJECT_UNAUTHORIZED=true

# --- auth ---
# Same Client ID as the frontend's NEXT_PUBLIC_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_VERIFY_TIMEOUT_MS=8000
# Must be at least 32 characters — the server refuses to start below that.
# A short secret is brute-forceable offline from a single captured token.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# Claims checked on every verify, so a token minted elsewhere cannot be replayed.
JWT_ISSUER=fluffy-api
JWT_AUDIENCE=fluffy-storefront
JWT_EXPIRES_IN=7d

# --- logging ---
LOG_LEVEL=debug

# --- email ---
# Unset means the console adapter: the whole pipeline runs and nothing is sent.
# That is the default for development and CI - no vendor account needed, and no
# real email can escape.
#
# BEFORE LAUNCH: configure a real provider AND set SPF/DKIM/DMARC on the sending
# domain. Transactional mail from an unverified domain lands in spam, and the
# client blames the site rather than the DNS.
RESEND_API_KEY=
EMAIL_FROM=Fluffy <orders@fluffy.ae>

# --- error tracking ---
# Unset means tracking is off: development and CI need no account, and no event
# can leak from a developer machine.
#
# Only UNEXPECTED errors are sent. A 404 or a rejected discount code is logged
# and never reported - burying real incidents under 404 noise is how alerting
# dies.
SENTRY_DSN=
# Ties an event to the deploy that produced it. Without it, "when did this
# start" is unanswerable. Most hosts expose a commit SHA to use here.
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
