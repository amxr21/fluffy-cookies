# --- server ---
PORT=4000
NODE_ENV=development
# comma-separated list of allowed frontend origins (storefront + admin)
ALLOWED_ORIGINS=http://localhost:3000

# --- database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fluffy
DB_CONNECTION_LIMIT=10
# DB_SSL=true
# DB_SSL_CA=/path/to/ca.pem
# DB_SSL_REJECT_UNAUTHORIZED=true

# --- auth ---
# Same Client ID as the frontend's NEXT_PUBLIC_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_VERIFY_TIMEOUT_MS=8000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- logging ---
LOG_LEVEL=debug
