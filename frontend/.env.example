# --- admin dashboard (server-only — never NEXT_PUBLIC_) ---
# Dashboard backend origin, read server-side by the storefront proxy and menu.
# Use its internal Coolify address or HTTPS API domain, without /api/v1 or a trailing slash.
API_ORIGIN=http://localhost:4000

# Integration key from the dashboard's API keys page, limited to products,
# categories, orders and discounts. Secret. Without it every storefront call
# fails with "API key required".
DASHBOARD_API_KEY=adk_replace_me

# Optional. The dashboard branch this storefront sells from. Leave unset when the
# dashboard has exactly one selling branch; with several, the menu is empty and
# checkout refuses until this is set.
# DASHBOARD_BRANCH_ID=

# --- auth ---
# Must match the dashboard backend's GOOGLE_CLIENT_ID exactly — it verifies the
# Google ID token with this value as the JWT *audience*, so any mismatch fails
# every sign-in with a generic "Google sign-in failed".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# Canonical public storefront URL for the sitemap and social metadata. The
# storefront bridge also accepts it as an Origin for sign-in, cart and checkout
# (alongside the host the browser actually asked for).
NEXT_PUBLIC_SITE_URL=https://fluffy.example.com

# --- client error reporting (optional) ---
# On by default; "false" turns it off. The endpoint defaults to /api/client-log.
# NEXT_PUBLIC_CLIENT_LOGGING_ENABLED=true
# NEXT_PUBLIC_CLIENT_LOG_ENDPOINT=/api/client-log
